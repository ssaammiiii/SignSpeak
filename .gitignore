# ---- secrets -------------------------------------------------------------
# Never commit the real key. env.example holds a placeholder only.
.env
.env.*
!.env.example

# ---- python --------------------------------------------------------------
__pycache__/
*.py[cod]
*.egg-info/
.venv/
venv/
.uv/
.ipynb_checkpoints/

# ---- trained models and run output --------------------------------------
# Regenerated by train_classical.py / train_words.py. Keep the metrics and
# figures if you want them browsable on GitHub; drop the next two lines to
# commit the fitted models as well.
*.joblib
*.keras

# ---- editors and OS ------------------------------------------------------
.vscode/
.idea/
*.swp
Thumbs.db
desktop.ini
$RECYCLE.BIN/

# ---- arduino -------------------------------------------------------------
firmware/**/build/
*.hex
*.elf

# ---- scratch -------------------------------------------------------------
*.bak
*_backup_*/
nohup.out
